[mysqld]

performance_schema=OFF

# cache principal
innodb_buffer_pool_size = 512M
innodb_buffer_pool_instances = 1

# connexions
max_connections = 25
thread_cache_size = 20

# tables temporaires
tmp_table_size = 32M
max_heap_table_size = 32M

# optimisation InnoDB
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
